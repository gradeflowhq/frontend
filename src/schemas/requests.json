        "const": "yaml",
        "title": "Format",
        "default": "yaml"
      }
    },
    "type": "object",
    "title": "YamlRubricConfig"
  },
  "LoadQuestionSetRequest": {
    "properties": {
      "data": {
        "type": "string",
        "title": "Data"
      },
