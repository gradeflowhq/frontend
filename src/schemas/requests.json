        "title": "Format",
        "default": "yaml"
      }
    },
    "type": "object",
    "title": "YamlQuestionSetConfig"
  },
  "ImportRubricRequest": {
    "properties": {
      "data": {
        "title": "Data",
        "description": "Source content; str or bytes",
        "type": [
          "string"
        ],
        "contentMediaType": "application/octet-stream"
      },
      "adapter": {
        "$ref": "#/definitions/ExamplifyRuleConfig"
      }
    },
    "type": "object",
    "required": [
      "data",
      "adapter"
    ],
    "title": "ImportRubricRequest"
  },
  "ExamplifyRuleConfig": {
    "properties": {
      "name": {
        "type": "string",
        "const": "examplify",
        "title": "Name",
        "default": "examplify"
      },
      "format": {
        "type": "string",
        "const": "csv",
        "title": "Format",
        "default": "csv"
      },
      "include_thrown_out": {
        "type": "boolean",
        "title": "Include Thrown Out",
        "default": false
      },
      "parse_answer_string": {
        "type": "boolean",
        "title": "Parse Answer String",
        "description": "Parse numeric-like FITB blanks as NUMERIC; else treat all as TEXT.",
        "default": false
      },
      "skip_empty_alternatives": {
        "type": "boolean",
        "title": "Skip Empty Alternatives",
        "description": "Ignore empty tokens in alternatives (e.g., trailing '|').",
        "default": true
      },
      "choice_mode": {
        "type": "string",
        "enum": [
          "ALL",
          "ANY",
          "PARTIAL"
        ],
        "title": "Choice Mode",
        "default": "PARTIAL"
      },
      "multi_valued_mode": {
        "type": "string",
        "enum": [
          "ALL",
          "ANY",
          "PARTIAL"
        ],
        "title": "Multi Valued Mode",
        "default": "PARTIAL"
      }
    },
    "type": "object",
    "title": "ExamplifyRuleConfig"
  },
  "ImportQuestionSetRequest": {
    "properties": {
      "data": {
        "title": "Data",
        "description": "Source content; str or bytes",
        "type": [
          "string"
        ],
        "contentMediaType": "application/octet-stream"
      },
      "adapter": {
        "$ref": "#/definitions/ExamplifyParseConfig"
      }
    },
    "type": "object",
    "required": [
      "data",
      "adapter"
    ],
    "title": "ImportQuestionSetRequest"
  },
  "ExamplifyParseConfig": {
    "properties": {
      "name": {
        "type": "string",
        "const": "examplify",
        "title": "Name",
        "default": "examplify"
      },
      "format": {
        "type": "string",
        "const": "csv",
        "title": "Format",
        "default": "csv"
      },
      "include_thrown_out": {
        "type": "boolean",
        "title": "Include Thrown Out",
        "default": false
      },
      "parse_answer_string": {
        "type": "boolean",
        "title": "Parse Answer String",
        "description": "Parse numeric-like FITB blanks as NUMERIC; else treat all as TEXT.",
        "default": false
      },
      "skip_empty_alternatives": {
        "type": "boolean",
        "title": "Skip Empty Alternatives",
        "description": "Ignore empty tokens in alternatives (e.g., trailing '|').",
        "default": true
      }
    },
    "type": "object",
    "title": "ExamplifyParseConfig"
  },
  "GradingDownloadRequest": {
    "properties": {
      "serializer": {
        "oneOf": [
          {
            "$ref": "#/definitions/CsvSubmissionsConfig"
          },
          {
            "$ref": "#/definitions/JsonSubmissionsConfig"
          },
          {
            "$ref": "#/definitions/YamlSubmissionsConfig"
          }
        ],
        "title": "Serializer",
        "discriminator": {
          "propertyName": "format",
          "mapping": {
            "csv": "#/definitions/CsvSubmissionsConfig",
            "json": "#/definitions/JsonSubmissionsConfig",
            "yaml": "#/definitions/YamlSubmissionsConfig"
          }
        }
      }
    },
    "type": "object",
    "required": [
      "serializer"
    ],
    "title": "GradingDownloadRequest"
  },
  "YamlSubmissionsConfig": {
    "properties": {
      "format": {
        "type": "string",
        "const": "yaml",
        "title": "Format",
        "default": "yaml"
      },
      "sort_keys": {
        "type": "boolean",
        "title": "Sort Keys",
        "default": false
      }
    },
    "type": "object",
    "title": "YamlSubmissionsConfig"
  },
  "JsonSubmissionsConfig": {
    "properties": {
      "format": {
        "type": "string",
        "const": "json",
        "title": "Format",
        "default": "json"
      },
      "ensure_ascii": {
        "type": "boolean",
        "title": "Ensure Ascii",
        "default": false
      }
    },
    "type": "object",
    "title": "JsonSubmissionsConfig"
  },
  "CsvSubmissionsConfig": {
    "properties": {
      "format": {
        "type": "string",
        "const": "csv",
        "title": "Format",
        "default": "csv"
      },
      "student_id_column": {
        "type": "string",
        "title": "Student Id Column",
        "default": "student_id"
      },
      "include_answers": {
        "type": "boolean",
        "title": "Include Answers",
        "default": true
      },
      "include_per_question_results": {
        "type": "boolean",
        "title": "Include Per Question Results",
        "default": true
      },
      "include_feedback": {
        "type": "boolean",
        "title": "Include Feedback",
        "default": true
      },
      "include_total": {
        "type": "boolean",
        "title": "Include Total",
        "default": true
      },
      "include_remarks": {
        "type": "boolean",
        "title": "Include Remarks",
        "default": true
      },
      "include_rounded_total": {
        "type": "boolean",
        "title": "Include Rounded Total",
        "default": true
      },
      "rounding_base": {
        "type": "number",
        "title": "Rounding Base",
        "default": 0.5
      }
    },
    "type": "object",
    "title": "CsvSubmissionsConfig"
  },
  "GradingLimitConfig": {
    "properties": {
      "limit": {
        "title": "Limit",
        "description": "If provided, preview only this many submissions.",
        "default": 5,
        "type": [
          "integer",
          "null"
        ],
        "maximum": 20,
        "minimum": 1
      },
      "selection": {
        "type": "string",
        "enum": [
          "first",
          "random",
          "random_unique"
        ],
        "title": "Selection",
        "description": "How to select limited submissions: 'first' (deterministic), 'random', or 'random_unique' (random unique answers).",
        "default": "random_unique"
      },
      "seed": {
        "title": "Seed",
        "description": "Random seed used when selection='random' or selection='random_unique' for reproducibility.",
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "type": "object",
    "title": "GradingLimitConfig"
  },
  "ExportRubricRequest": {
    "properties": {
